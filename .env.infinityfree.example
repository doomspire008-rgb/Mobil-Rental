APP_NAME=RentalMobilku
APP_ENV=production
APP_KEY=base64:xdRu7JdYnooZh31FwOcNxBCn15ZL8QTUruVMG9PPtgI=
APP_DEBUG=false
APP_URL=http://yourdomain.infinityfreeapp.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ================================================================
# KONFIGURASI DATABASE INFINITYFREE (MySQL)
# Dapatkan data ini dari cPanel/vPanel InfinityFree -> MySQL Databases
# ================================================================
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=epiz_XXXXXXXX_carrental
DB_USERNAME=epiz_XXXXXXXX
DB_PASSWORD=password_cpanel_infinityfree_anda

# ================================================================
# SESI & CACHE
# Menggunakan 'file' sangat stabil untuk Shared Hosting InfinityFree
# ================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=single
LOG_LEVEL=error

VITE_APP_NAME="${APP_NAME}"
